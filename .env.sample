CLIENT_SANITY_PROJECT_ID=[your_variable_here]
CLIENT_SANITY_DATASET=[your_variable_here]
CLIENT_SANITY_API_VERSION=[your_variable_here]
CLIENT_SANITY_USE_CDN=[your_variable_here]
CLIENT_FINANCE_API_BASE_URL=[your_variable_here]
CLIENT_API_SANDBOX=

# Replace [your_variable_here] with your actual Sanity project ID, dataset, API version, CDN usage preference, and the Power Finance API origin.
# CLIENT_API_SANDBOX is optional: set it to your Power Finance sandbox name to route requests there.
